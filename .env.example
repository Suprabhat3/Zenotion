# Postgres connection string
DATABASE_URL=

# Better Auth — use a long random secret in production (32+ chars)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth (email/password still works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ImageKit (note image + cover uploads; leave blank to disable uploads)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# PostHog product analytics (browser SDK — safe to expose in the client bundle)
# Copy from PostHog → Settings → Project → General → Project token
NEXT_PUBLIC_POSTHOG_KEY=
# US Cloud: https://us.i.posthog.com | EU Cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
