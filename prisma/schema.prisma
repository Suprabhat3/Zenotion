// Prisma schema for Zenotion — a Notion-style AI notes app.
// Prisma 7 uses the `prisma-client` generator with an explicit output path.
// Import the client from "@/app/generated/prisma/client".

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth models
// These table/field shapes follow the Better Auth Prisma adapter conventions.
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // The single "secret note credit": at most one note per user may be
  // marked secret. Enforced here (unique) rather than by counting notes.
  secretNoteId String? @unique

  sessions Session[]
  accounts Account[]
  notes    Note[]
  folders  Folder[]
  tags     Tag[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes Note[]

  @@index([userId])
  @@map("folder")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes NoteTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tag")
}

model Note {
  id         String   @id @default(cuid())
  title      String   @default("Untitled")
  content    String   @default("")
  // Notion-style page decorations: an emoji icon and a cover image URL
  // (uploaded to ImageKit; only the URL is stored).
  icon       String?
  coverImage String?
  isPublic   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  // Zero-knowledge secret note: when `isSecret` is true, `content` holds the
  // base64 AES-GCM ciphertext of { title, content }, encrypted client-side
  // with a key derived from the user's passphrase. The server stores only
  // opaque material and can never decrypt.
  isSecret       Boolean @default(false)
  secretSalt     String? // base64 PBKDF2 salt
  secretIv       String? // base64 AES-GCM IV of the current ciphertext (rotates each save)
  secretVerifier String? // base64 hash of a separately derived key; proves passphrase knowledge, cannot decrypt
  shareSlug  String?  @unique
  // Soft delete: when set, the note lives in the trash and is excluded from all
  // listings, search, and public routes. Cleared on restore; a permanent delete
  // removes the row entirely.
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  tags      NoteTag[]
  versions  NoteVersion[]

  // Wiki-style links between notes, maintained from note content on save.
  outgoingLinks NoteLink[] @relation("NoteLinkSource")
  incomingLinks NoteLink[] @relation("NoteLinkTarget")

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([folderId])
  @@index([shareSlug])
  @@map("note")
}

// Directed link from one note to another (`[[wiki link]]`). The row set for a
// source note is rebuilt whenever its content is saved; querying by target
// yields the "linked references" (backlinks) for a note.
model NoteLink {
  sourceNoteId String
  targetNoteId String

  source Note @relation("NoteLinkSource", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  target Note @relation("NoteLinkTarget", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@id([sourceNoteId, targetNoteId])
  @@index([targetNoteId])
  @@map("note_link")
}

model NoteVersion {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_version")
}

// Explicit join table so we can carry metadata later if needed.
model NoteTag {
  noteId String
  tagId  String

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tag")
}
